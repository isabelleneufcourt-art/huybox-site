# Base de données PostgreSQL (ex. Neon, Vercel Postgres). Neon fournit deux
# connection strings distinctes (bouton "Pooled connection" à cocher/décocher
# dans son tableau de bord) : copie la version POOLED (host contenant
# "-pooler") dans DATABASE_URL, et la version DIRECTE (même host SANS
# "-pooler") dans DIRECT_URL. DIRECT_URL n'est utilisée que par les
# migrations (`prisma migrate`) — la connexion poolée ne supporte pas le
# verrou qu'elles posent (erreur P1002 sinon).
DATABASE_URL="postgresql://user:password@host-pooler/dbname?sslmode=require"
DIRECT_URL="postgresql://user:password@host/dbname?sslmode=require"

# Session admin (back-office)
# Génère une valeur longue et aléatoire, ex: `openssl rand -hex 32`
ADMIN_SESSION_SECRET="change-moi-en-une-chaine-aleatoire-longue"
ADMIN_EMAIL="admin@huybox.example"
# Mot de passe admin en clair (pas de hash à générer/copier-coller).
ADMIN_PASSWORD="change-moi"

# Coordonnées du centre (utilisées dans tout le site + JSON-LD)
NEXT_PUBLIC_SITE_URL="https://www.huybox.example"
NEXT_PUBLIC_SITE_NAME="HUYBOX"
NEXT_PUBLIC_PHONE_NUMBER="+32 2 000 00 00"
NEXT_PUBLIC_PHONE_NUMBER_DISPLAY="02 000 00 00"
NEXT_PUBLIC_CONTACT_EMAIL="info@huybox.be"
NEXT_PUBLIC_ADDRESS_STREET="Rue de l'Entrepôt 12"
NEXT_PUBLIC_ADDRESS_CITY="1000 Bruxelles"
NEXT_PUBLIC_ADDRESS_COUNTRY="Belgique"
NEXT_PUBLIC_GOOGLE_MAPS_EMBED_URL="https://www.google.com/maps?q=Rue+de+l%27Entrep%C3%B4t+12,1000+Bruxelles&output=embed"
# Laisser vide tant qu'il n'y a pas de vraie vidéo : la section "Visite
# virtuelle" est alors masquée automatiquement sur le site.
NEXT_PUBLIC_VIRTUAL_TOUR_VIDEO_URL=""

# Analytics (optionnel)
NEXT_PUBLIC_GA4_ID=""
NEXT_PUBLIC_GTM_ID=""

# Emailing accusé de réception (optionnel — laisser vide pour désactiver).
# Adresse d'envoi technique des emails automatiques — distincte de
# NEXT_PUBLIC_CONTACT_EMAIL (l'adresse affichée aux visiteurs).
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM="no-reply@huybox.be"
